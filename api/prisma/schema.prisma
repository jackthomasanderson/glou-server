// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Profile & Preferences
  displayName  String?
  avatarUrl    String?
  appName      String?
  appSlogan    String?

  theme        Theme      @default(LIGHT)
  language     Language   @default(FR)
  tempUnit     TempUnit   @default(CELSIUS)
  accentColor  String     @default("#6366f1")
  dateFormat   DateFormat @default(SYSTEM)

  // Security (2FA)
  isTwoFactorEnabled Boolean    @default(false)
  twoFactorSecret    String?
  backupCodes        String[]   @default([])

  // Quick Lock & Auto-Lock (FEAT-30) — client-side lock, no impact on Session validity
  pinHash            String?    // bcrypt hash of a 4-6 digit unlock PIN, optional
  autoLockDelayMin   Int?       // 5, 15, 30 or null = never

  // Admin
  isAdmin            Boolean    @default(false)
  isActive           Boolean    @default(true)

  // RGPD
  deletionRequestedAt DateTime?

  // Notifications (FEAT-32)
  notifInApp         Boolean    @default(true)
  notifEmail         Boolean    @default(false)
  notifWebhook       Boolean    @default(false)
  notifCategories    String[]   @default([])
  notifQuietStart    Int?
  notifQuietEnd      Int?
  notifLanguage      Language?
  webhookUrl         String?

  inventory    InventoryItem[]
  auditLogs    AuditLog[]
  cellars      Cellar[]
  bulkPresets  BulkPreset[]
  collections  Collection[]
  tastingNotes TastingNote[]
  passwordResetTokens PasswordResetToken[]
  configChangeLogs ConfigChangeLog[]
  sessions            Session[]
  trustedDevices      TrustedDevice[]
}

enum Theme {
  LIGHT
  DARK
}

enum Language {
  FR
  EN
}

enum TempUnit {
  CELSIUS
  FAHRENHEIT
}

enum DateFormat {
  SYSTEM
  H24
  H12
}

enum CellarType {
  VINTAGE // Cave de vieillissement/enterrée
  COOLER // Armoire de mise à température / de service
  SHELF // Étagère / Vitrine / Stockage passif
}

model Cellar {
  id          String     @id @default(uuid())
  name        String
  description String?
  type        CellarType @default(VINTAGE)

  // Grid plan configuration (FEAT-68) — all optional
  columns      Int? // Grid width (number of columns)
  rows         Int? // Grid height (number of rows)
  hotZoneRows  Int? // Number of rows from top with higher temperature
  coldZoneRows Int? // Number of rows from bottom with lower temperature

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inventory InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("cellars")
}

// Soft-delete via deletedAt
model InventoryItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cellarId String?
  cellar   Cellar? @relation(fields: [cellarId], references: [id], onDelete: SetNull)

  // Grid slot assignment (FEAT-68) — 1-based coordinates, null = no slot
  slotColumn Int?
  slotRow    Int?

  // Common fields
  category       BottleCategory
  name           String
  producer       String // producer/house/distillery/brand
  location       String? // cave/clayette reference
  collection     String?
  tags           String[]       @default([])
  photoUrl       String?
  notes          String?
  purchasePrice  Float?
  purchasePlace  String?
  estimatedValue Float?

  // Contextual — Wine & Sparkling
  vintage        Int? // millésime, null = sans année
  color          String? // rouge/blanc/rosé/orange
  region         String?
  grapeVarieties String[]  @default([])
  alcoholDegree  Float?
  bottleSize     String? // 75cl, magnum...
  needsAeration  Boolean?
  serviceTemp    String?
  lotNumber      String?
  batchDate      DateTime?

  // Contextual — Sparkling extras
  sparklingType  String? // Champagne, Crémant, Prosecco...
  sugarLevel     String? // extra-brut, brut, extra-sec, sec, demi-sec, doux
  disgorgingDate DateTime?
  baseYear       Int?

  // Contextual — Spirit
  spiritType      String? // whisky, rhum, gin, cognac...
  edition         String?
  declaredAge     Int?    // âge en années
  caskType        String?
  additions       String?
  aromaticProfile String?

  // Contextual — Cigar
  format               String? // Corona, Robusto...
  quantity             Int?
  manufactureYear      Int?
  leafOrigin           String?
  factoryCode          String?
  recommendedHumidity  Float?
  humidificationSystem String?

  // Peak maturity window (structured, year-based)
  peakMaturityFrom Int?    // Start year of optimal drinking window
  peakMaturityTo   Int?    // End year of optimal drinking window
  alertsPaused     Boolean @default(false) // User-paused alerts for this bottle

  // Cross-cutting fields
  isOpened     Boolean   @default(false)
  fillLevel    Int?      // 0-100 (%)
  openedAt     DateTime?
  reminderDate DateTime?
  alertStatus  String?   // none, approaching, peak, past (auto-computed from peakMaturityFrom/To)

  // Traceability
  updatedBy    String?   // userId of the last editor (null = no edits yet)

  // Integrity
  lockedFields String[]  @default([]) // User-locked fields, not overwritten by auto-enrichment
  syncedAt     DateTime? // Last third-party sync timestamp

  // Soft-delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs    AuditLog[]
  collections  Collection[] @relation("CollectionItems")
  tastingNotes TastingNote[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, category])
  @@index([alertStatus])
  @@index([name])
  @@index([vintage])
  @@index([producer])
  @@map("bottles")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bottleId  String?
  bottle    InventoryItem?  @relation(fields: [bottleId], references: [id], onDelete: SetNull)
  action    String // CREATE, READ, UPDATE, DELETE, RESTORE, LIST
  status    String // success, error, validation_error, not_found
  ip        String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum BottleCategory {
  wine
  sparkling
  spirit
  cigar
}

enum MaturityMode {
  ABSOLUTE
  RELATIVE
}

model MaturityReference {
  id          String         @id @default(uuid())
  name        String
  category    BottleCategory

  // Optional matching criteria (specificity determines priority)
  region      String?
  color       String?
  producer    String?
  vintageFrom Int?
  vintageTo   Int?

  // Peak window
  mode        MaturityMode
  windowFrom  Int
  windowTo    Int

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@map("maturity_references")
}

model BulkPreset {
  id        String   @id @default(uuid())
  name      String
  payload   Json     // The InventoryPatch to apply
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("bulk_presets")
}

model Collection {
  id        String          @id @default(uuid())
  name      String
  color     String          @default("#6366f1")
  icon      String?
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     InventoryItem[] @relation("CollectionItems")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@map("collections")
}

model GuestShare {
  id            String    @id @default(cuid())
  token         String    @unique @default(cuid())
  label         String?
  inviteeName   String? // Display name of the invited person (FEAT-37), distinct from `label`
  expiresAt     DateTime?
  revokedAt     DateTime?
  hidePrices    Boolean   @default(false)
  hideNotes     Boolean   @default(false)
  cellarIds     String[]
  // Subset of cellarIds granted read/write access (FEAT-37). Cellars in cellarIds
  // but absent here remain read-only. Never a superset of cellarIds.
  writeCellarIds String[] @default([])
  collectionIds String[]
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdBy])
  @@index([token])
  @@map("guest_shares")
}

enum TastingReadiness {
  TOO_YOUNG
  PERFECT
  PEAK
  PAST
}

model TastingNote {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  tastedAt    DateTime          @default(now())
  context     String?
  rating      Int?
  readiness   TastingReadiness?
  notes       String?
  foodPairing String?
  photoUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([itemId])
  @@map("tasting_notes")
}

// ─── FEAT-28: Password Reset Tokens ──────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── FEAT-25: Sessions & Trusted Devices ──────────────────────────────────────

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ip           String?
  rememberMe   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model TrustedDevice {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  country    String? // ISO country code at creation time, for anomaly detection
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@map("trusted_devices")
}

// ─── FEAT-34/53: System Configuration (singleton) ────────────────────────────

model SystemConfig {
  id String @id @default("singleton")

  // SMTP (FEAT-34/53)
  smtpEnabled Boolean @default(false)
  smtpHost    String?
  smtpPort    Int?
  smtpUser    String?
  smtpPassEnc String? // AES-256-GCM encrypted
  smtpFrom    String?
  smtpSecure  Boolean @default(true)

  // Gotify/Webhook (FEAT-34/53)
  gotifyEnabled  Boolean @default(false)
  gotifyUrl      String?
  gotifyTokenEnc String? // AES-256-GCM encrypted

  // In-app notifications (FEAT-53)
  inAppEnabled Boolean @default(true)

  // External API integrations (FEAT-34)
  vivinoKeyEnc     String? // AES-256-GCM encrypted
  whiskybaseKeyEnc String? // AES-256-GCM encrypted
  ocrUrl           String?

  // Data retention (FEAT-39) — delay after which an expired/revoked row
  // (Session, TrustedDevice, GuestShare) is permanently deleted. This is
  // NOT the validity window itself, which remains governed by `expiresAt`.
  logRetentionDays         Int @default(90)
  sessionRetentionDays     Int @default(30)
  guestShareRetentionDays  Int @default(30)

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─── FEAT-39: Maintenance & Data Retention ────────────────────────────────────

model MaintenanceRun {
  id          String   @id @default(uuid())
  runAt       DateTime @default(now())
  trigger     String // 'scheduled' | 'manual'
  triggeredBy String? // userId, set when trigger = 'manual'
  success     Boolean
  counts      Json?
  error       String?
  durationMs  Int?

  @@index([runAt])
  @@map("maintenance_runs")
}

// ─── FEAT-34: Config Change History ──────────────────────────────────────────

model ConfigChangeLog {
  id           Int      @id @default(autoincrement())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldName    String
  maskedOldVal String?
  maskedNewVal String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("config_change_logs")
}
