// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  // Profile & Preferences
  displayName  String?
  avatarUrl    String?
  appName      String?    // Personal app name (replaces "GLOU")
  appSlogan    String?    // Personal app slogan
  
  theme        Theme      @default(LIGHT)
  language     Language   @default(FR)
  tempUnit     TempUnit   @default(CELSIUS)
  accentColor  String     @default("#6366f1")
  dateFormat   DateFormat @default(SYSTEM)

  // Security (2FA)
  isTwoFactorEnabled Boolean    @default(false)
  twoFactorSecret    String?
  backupCodes        String[]   @default([])

  // Admin
  isAdmin            Boolean    @default(false)

  bottles      Bottle[]
  auditLogs    AuditLog[]
  cellars      Cellar[]
  bulkPresets  BulkPreset[]
}

enum Theme {
  LIGHT
  DARK
}

enum Language {
  FR
  EN
}

enum TempUnit {
  CELSIUS
  FAHRENHEIT
}

enum DateFormat {
  SYSTEM
  H24
  H12
}

enum CellarType {
  VINTAGE // Cave de vieillissement/enterrée
  COOLER // Armoire de mise à température / de service
  SHELF // Étagère / Vitrine / Stockage passif
}

model Cellar {
  id          String     @id @default(uuid())
  name        String
  description String?
  type        CellarType @default(VINTAGE)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bottles Bottle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("cellars")
}

// Soft-delete via deletedAt
model Bottle {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cellarId String?
  cellar   Cellar? @relation(fields: [cellarId], references: [id], onDelete: SetNull)

  // Common fields
  category       BottleCategory
  name           String
  producer       String // producer/house/distillery/brand
  location       String? // cave/clayette reference
  collection     String?
  tags           String[]       @default([])
  photoUrl       String?
  notes          String?
  purchasePrice  Float?
  purchasePlace  String?
  estimatedValue Float?

  // Contextual — Wine & Sparkling
  vintage        Int? // millésime, null = sans année
  color          String? // rouge/blanc/rosé/orange
  region         String?
  grapeVarieties String[]  @default([])
  alcoholDegree  Float?
  bottleSize     String? // 75cl, magnum...
  peakMaturity   String? // période idéale dégustation
  needsAeration  Boolean?
  serviceTemp    String?
  lotNumber      String?
  batchDate      DateTime?

  // Contextual — Sparkling extras
  sparklingType  String? // Champagne, Crémant, Prosecco...
  sugarLevel     String? // brut, extra-brut...
  disgorgingDate DateTime?
  baseYear       Int?

  // Contextual — Spirit
  distilleryName  String?
  edition         String?
  declaredAge     String?
  caskType        String?
  additions       String?
  aromaticProfile String?

  // Contextual — Cigar
  brand                String?
  format               String? // Corona, Robusto...
  quantity             Int?
  manufactureYear      Int?
  sealedStatus         String? // sealed, opened
  leafOrigin           String?
  factoryCode          String?
  recommendedHumidity  Float?
  humidificationSystem String?

  // Peak maturity window (structured, year-based)
  peakMaturityFrom Int?    // Start year of optimal drinking window
  peakMaturityTo   Int?    // End year of optimal drinking window
  alertsPaused     Boolean @default(false) // User-paused alerts for this bottle

  // Cross-cutting fields
  isOpened     Boolean   @default(false)
  fillLevel    Int?      // 0-100 (%)
  openedAt     DateTime?
  reminderDate DateTime?
  alertStatus  String?   // none, approaching, peak, past (auto-computed from peakMaturityFrom/To)

  // Integrity
  lockedFields String[]  @default([]) // User-locked fields, not overwritten by auto-enrichment
  syncedAt     DateTime? // Last third-party sync timestamp

  // Soft-delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, category])
  @@index([alertStatus])
  @@index([name])
  @@index([vintage])
  @@index([producer])
  @@map("bottles")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bottleId  String?
  bottle    Bottle?  @relation(fields: [bottleId], references: [id], onDelete: SetNull)
  action    String // CREATE, READ, UPDATE, DELETE, RESTORE, LIST
  status    String // success, error, validation_error, not_found
  ip        String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum BottleCategory {
  wine
  sparkling
  spirit
  cigar
}

model BulkPreset {
  id        String   @id @default(uuid())
  name      String
  payload   Json     // The BottlePatch to apply
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("bulk_presets")
}
