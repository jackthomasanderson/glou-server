legacy-peer-deps=true
# Known incompatibility knowingly hidden by the line above, as of the
# Tailwind 3 → 4 migration (#392): react-leaflet@5.0.0 (and its
# @react-leaflet/core@3.0.0 peer) requires react/react-dom ^19.0.0, while
# this project is still on React 18 (@heroui/react's own dependency tree is
# React 18/19-compatible and installs cleanly either way). Tracked
# separately by #225/#395 (replacing the Leaflet-based map), which should
# remove the need for this line once it lands. Re-run `npm install
# --legacy-peer-deps=false` after that to confirm nothing else is hidden.
