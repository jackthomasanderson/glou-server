# =============================================================
# Glou — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles
# =============================================================

# --- Base de données PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_USER=glou
DB_PASSWORD=change_me_in_production
DB_NAME=glou_db

# Prisma (construit depuis les variables ci-dessus)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Sécurité ---
JWT_SECRET=change_me_with_a_strong_random_secret_64chars
CONFIG_ENCRYPTION_KEY=change_me_with_a_strong_random_secret_64chars

# --- Application ---
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Docker (non-root) ---
PUID=1000
PGID=1000
